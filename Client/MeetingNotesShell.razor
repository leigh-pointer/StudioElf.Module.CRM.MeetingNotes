@attribute [OqtaneIgnore]
@namespace StudioElf.Module.CRM.MeetingNotes
@using Oqtane.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using StudioElf.Module.CRM
@using StudioElf.Module.CRM.Models
@using StudioElf.Module.CRM.Components
@using StudioElf.Module.CRM.MeetingNotes.Models
@using StudioElf.Module.CRM.MeetingNotes.Services
@inherits CrmBase
@inject IMeetingNotesService MeetingNotesService
@inject StudioElf.Module.CRM.Services.IEmailService EmailService

@*
    Meeting Notes — Self-contained extension tab.
    Shows all meetings across contacts with search and sort.
    Contact selector is inside the Add/Edit dialog.
*@
<div class="crm-shell">
    @* Toolbar: search, sort, add *@
    <div class="d-flex justify-content-between align-items-center gap-2 mb-2 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <h6 class="mb-0">@MeetingNotesModuleInfo.DisplayName</h6>
            <input type="text" class="form-control form-control-sm" style="width:180px;"
                   placeholder="Search meetings..." @bind="@_searchText" @bind:after="ApplyFilter" />
            <select class="form-select form-select-sm" style="width:auto;" @bind="@_sortField">
                <option value="date">Date</option>
                <option value="title">Title</option>
                <option value="contact">Contact</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="@(() => _sortDesc = !_sortDesc)" title="Toggle sort order">
                <i class="bi bi-arrow-@(_sortDesc ? "down" : "up")"></i>
            </button>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(AddNewMeeting)">
            <i class="bi bi-plus-circle me-1"></i>Add Meeting
        </button>
    </div>

    @* Success/status banner — rendered above the list, never replaces it *@
    @if (_status != null)
    {
        <div class="alert alert-success small py-2 d-flex justify-content-between align-items-center">
            <span>@_status</span>
            <button type="button" class="btn-close btn-sm" @onclick="@(() => _status = null)" title="Dismiss"></button>
        </div>
    }

    @if (_loading)
    {
        <p class="text-muted"><em>Loading...</em></p>
    }
    else if (_error != null)
    {
        <div class="alert alert-warning small py-2 d-flex justify-content-between align-items-center">
            <span>@_error</span>
            <button type="button" class="btn-close btn-sm" @onclick="@(() => _error = null)" title="Dismiss"></button>
        </div>
    }
    else if (!_displayItems.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-journal-text" style="font-size:2.5rem;"></i>
            <p class="mt-2 mb-1">@(string.IsNullOrEmpty(_searchText) ? "No meetings recorded yet." : "No meetings match your search.")</p>
            <small>@(string.IsNullOrEmpty(_searchText) ? "Click \"Add Meeting\" above to record the first meeting." : "Try a different search term.")</small>
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var m in _displayItems)
            {
                <div class="list-group-item list-group-item-action px-0">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>@m.Title</strong>
                            <span class="text-muted small ms-2">
                                @FormatLocalDate(m.MeetingDate, "MMM dd, yyyy") · @m.DurationMinutes min
                                @if (!string.IsNullOrEmpty(m.CreatedBy))
                                {
                                    <span class="ms-2">· @m.CreatedBy</span>
                                }
                                @if (!string.IsNullOrEmpty(m.Location))
                                {
                                    <span class="ms-2"><i class="bi bi-geo-alt"></i> @m.Location</span>
                                }
                            </span>
                        </div>
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-info py-0 px-1" @onclick="@(() => SendSummary(m))" title="Send email summary">
                                <i class="bi bi-envelope"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="@(() => BeginEdit(m))" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" @onclick="@(() => ConfirmDelete(m))" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(m.Summary))
                    {
                        @* Render markdown + @mention tokens as styled spans (inherited from CrmBase) *@
                        <small class="d-block mt-1 text-muted rendered-content">@((MarkupString)RenderMarkdown(m.Summary))</small>
                    }
                </div>
            }
        </div>
    }
</div>

@* ── Add/Edit Meeting modal — contains contact selector *@
@if (_editing)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.3);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-journal-text me-1"></i>@(_editingId > 0 ? "Edit Meeting" : "New Meeting")</h6>
                    <button type="button" class="btn-close btn-sm" @onclick="@(CancelEdit)"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">Contact</label>
                        <select class="form-select form-select-sm" @bind="@_editContactId">
                            <option value="0">— Select a contact —</option>
                            @foreach (var c in _contacts)
                            {
                                <option value="@c.ContactId">@c.FirstName @c.LastName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Title</label>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. Q1 Review" @bind="@_edit.Title" />
                    </div>
                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="form-label small">Date</label>
                            <input type="date" class="form-control form-control-sm" @bind="@_editDate" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Duration (min)</label>
                            <input type="number" class="form-control form-control-sm" @bind="@_edit.DurationMinutes" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Location</label>
                        <input type="text" class="form-control form-control-sm" placeholder="e.g. Office, Zoom" @bind="@_edit.Location" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Attendees</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Comma-separated names" @bind="@_edit.Attendees" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Summary</label>
                        @* CRM MentionEditor: @mention autocomplete, preview toggle, mention notification emails *@
                        <MentionEditor @ref="_summaryEditor"
                                       Content="@_edit.Summary"
                                       ContentChanged="@((c) => _edit.Summary = c)"
                                       ModuleId="ModuleState.ModuleId"
                                       EntityName="Meeting Note"
                                       EntityId="@_editingId"
                                       Height="140px"
                                       ShowPreview="true"
                                       PreviewRenderer="RenderPreviewAsync" />
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="@(CancelEdit)">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="@(SaveMeeting)" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Delete confirmation modal ── *@
@if (_confirmDelete != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.3);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title"><i class="bi bi-trash me-1"></i>Delete Meeting</h6>
                    <button type="button" class="btn-close btn-sm" @onclick="@(() => _confirmDelete = null)"></button>
                </div>
                <div class="modal-body small">
                    Delete "<strong>@_confirmDelete.Title</strong>"?
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="@(() => _confirmDelete = null)">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger" @onclick="@(DeleteMeeting)"><i class="bi bi-trash me-1"></i>Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ContactListDto> _contacts = new();
    private List<MeetingNoteDto> _allItems = new();
    private List<MeetingNoteDto> _displayItems = new();
    private bool _loading = true;
    private string _error;
    private string _status;
    private string _searchText = "";
    private string _sortField = "date";
    private bool _sortDesc = true;
    private bool _editing;
    private bool _saving;
    private int _editingId;
    private int _editContactId;
    private int _deepLinkMeetingId;
    private string _lastDeepLinkUri = "";
    private CreateMeetingNoteDto _edit = new();
    private DateOnly? _editDate;
    private MeetingNoteDto _confirmDelete;

    // Mention editor (CRM component — @mentions + notification emails)
    private MentionEditor _summaryEditor;

    /// <summary>
    /// Preview renderer for the MentionEditor — same Markdig pipeline as the
    /// list view (mentions render as styled spans).
    /// </summary>
    private Task<string> RenderPreviewAsync(string markdown)
        => Task.FromResult(RenderMarkdown(markdown ?? ""));

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Query changes (e.g. navigating to a new ?ticket={id} while this
        // shell stays alive) re-apply the deep link without recreating the component.
        _ = ApplyDeepLinkAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Deep-link: mention notification emails point here with ?ticket={id}
        await ApplyDeepLinkAsync();

        await LoadContacts();
        await LoadMeetings();
    }

    /// <summary>
    /// Reads ?ticket={id} from the URL (the CRM mention notification deep
    /// link — Index?tab=ext:MeetingNotes&amp;ticket={id}). Falls back to
    /// PageState.QueryString because NavigationManager.Uri may not include
    /// query params during SSR. Skipped when the URL is unchanged so the
    /// edit dialog is not re-opened after the list reloads.
    /// </summary>
    private async Task ApplyDeepLinkAsync()
    {
        try
        {
            var uri = NavigationManager.Uri;
            if (uri == _lastDeepLinkUri) return;
            _lastDeepLinkUri = uri;

            string ticketParam = null;
            if (uri.Contains('?'))
            {
                var qs = System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query);
                ticketParam = qs["ticket"];
            }
            if (string.IsNullOrEmpty(ticketParam) && PageState?.QueryString != null && PageState.QueryString.Count > 0)
            {
                foreach (var kv in PageState.QueryString)
                {
                    if (string.Equals(kv.Key, "ticket", StringComparison.OrdinalIgnoreCase))
                        ticketParam = kv.Value;
                }
            }

            if (!string.IsNullOrEmpty(ticketParam) && int.TryParse(ticketParam, out var meetingId) && meetingId > 0)
                _deepLinkMeetingId = meetingId;
        }
        catch { /* not a deep link */ }
    }

    private async Task LoadContacts()
    {
        try
        {
            var filter = new ContactFilter();
            _contacts = await CrmService.GetContactsAsync(ModuleState.ModuleId, filter) ?? new();
        }
        catch { _contacts = new(); }
    }

    private async Task LoadMeetings()
    {
        _loading = true;
        _error = null;
        try
        {
            _allItems = await MeetingNotesService.GetAllAsync(ModuleState.ModuleId);
            ApplyFilter();

            // Deep link (?ticket={id}) — open that meeting in the edit dialog
            if (_deepLinkMeetingId > 0)
            {
                var meeting = _allItems.FirstOrDefault(m => m.Id == _deepLinkMeetingId);
                if (meeting != null) BeginEdit(meeting);
                _deepLinkMeetingId = 0;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _allItems = new();
            _displayItems = new();
        }
        _loading = false;
    }

    private void ApplyFilter()
    {
        var q = _searchText?.Trim().ToLower() ?? "";
        var filtered = string.IsNullOrEmpty(q)
            ? _allItems.ToList()
            : _allItems.Where(m =>
                (m.Title?.ToLower().Contains(q) == true) ||
                (m.Summary?.ToLower().Contains(q) == true) ||
                (m.Location?.ToLower().Contains(q) == true) ||
                (m.CreatedBy?.ToLower().Contains(q) == true))
            .ToList();

        _displayItems = _sortField switch
        {
            "title" => _sortDesc ? filtered.OrderByDescending(m => m.Title).ToList()
                                  : filtered.OrderBy(m => m.Title).ToList(),
            "contact" => _sortDesc ? filtered.OrderByDescending(m => m.CreatedBy).ToList()
                                   : filtered.OrderBy(m => m.CreatedBy).ToList(),
            _ => _sortDesc ? filtered.OrderByDescending(m => m.MeetingDate).ToList()
                           : filtered.OrderBy(m => m.MeetingDate).ToList(),
        };
        StateHasChanged();
    }

    private void BeginEdit(MeetingNoteDto m)
    {
        _editingId = m.Id;
        _editContactId = m.ContactId;
        _edit = new()
        {
            ContactId = m.ContactId,
            Title = m.Title,
            Summary = m.Summary,
            MeetingDate = m.MeetingDate,
            DurationMinutes = m.DurationMinutes,
            Location = m.Location,
            ActionItems = m.ActionItems,
            Attendees = m.Attendees
        };
        _editDate = DateOnly.FromDateTime(m.MeetingDate);
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _editingId = 0;
        _edit = new();
    }

    private async Task SaveMeeting()
    {
        _saving = true;
        try
        {
            _edit.MeetingDate = _editDate.HasValue ? _editDate.Value.ToDateTime(TimeOnly.MinValue) : DateTime.Today;
            _edit.ContactId = _editContactId;

            var meetingId = _editingId;
            if (meetingId > 0)
            {
                await MeetingNotesService.UpdateAsync(meetingId, _edit, ModuleState.ModuleId, PageState.User.Username);
            }
            else
            {
                var created = await MeetingNotesService.CreateAsync(_edit, ModuleState.ModuleId, PageState.User.Username);
                meetingId = created?.Id ?? 0;
            }

            // Tell the MentionEditor it is saved WHILE it is still mounted -
            // NotifyMentionsAsync reads the text back from the live editor
            // buffer, so it must run before the modal closes and the buffer
            // is disposed. Every path below is caught, so a notification
            // failure can never trap the user in the modal.
            var summary = _edit.Summary;
            var userName = PageState.User.Username;
            var mentionUrl = $"Index?tab=ext:{MeetingNotesModuleInfo.ExtensionId}&ticket={meetingId}";
            try
            {
                if (_summaryEditor != null)
                    await _summaryEditor.NotifyMentionsAsync(userName, mentionUrl);
                else
                    await CrmService.ProcessMentionNotificationsAsync(ModuleState.ModuleId, summary, "Meeting Note", meetingId, userName, null, mentionUrl);
            }
            catch (Exception ex)
            {
                // Monaco interop failed (e.g. editor never initialized in the
                // modal) - fall back to the captured form content.
                try { await CrmService.ProcessMentionNotificationsAsync(ModuleState.ModuleId, summary, "Meeting Note", meetingId, userName, null, mentionUrl); }
                catch { _error = $"Meeting saved, but mention notification failed: {ex.Message}"; }
            }

            // Close the dialog and reload the list LAST - always reached.
            _editing = false;
            _editingId = 0;
            _edit = new();
            await LoadMeetings();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _saving = false;
    }

    private void AddNewMeeting()
    {
        _editingId = 0;
        _editContactId = 0;
        _edit = new();
        _editing = true;
    }

    private async Task SendSummary(MeetingNoteDto m)
    {
        try
        {
            // Ensure the default template exists — the CRM seeds extension
            // templates only when the extension is (re)installed, so a module
            // installed before this extension loaded has no "Meeting Summary"
            // template and SendTemplateAsync silently returns. Idempotent.
            await CrmService.SeedDefaultTemplatesAsync(ModuleState.ModuleId, new() { MeetingNotesModuleInfo.ExtensionId });

            var tokens = new Dictionary<string, string>
            {
                ["MeetingTitle"] = m.Title ?? "",
                ["MeetingDate"] = m.MeetingDate.ToString("dd-MMM-yyyy"),
                ["AttendeeCount"] = string.IsNullOrEmpty(m.Attendees) ? "0" : m.Attendees.Split(',').Length.ToString(),
                ["Summary"] = m.Summary ?? "",
                ["ActionItems"] = m.ActionItems ?? ""
            };
            await EmailService.SendTemplateAsync(ModuleState.ModuleId, MeetingNotesModuleInfo.ExtensionId, "Meeting Summary", m.ContactId, tokens);
            _status = "Summary sent to contact.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void ConfirmDelete(MeetingNoteDto m) => _confirmDelete = m;

    private async Task DeleteMeeting()
    {
        if (_confirmDelete == null) return;
        try
        {
            await MeetingNotesService.DeleteAsync(_confirmDelete.Id, ModuleState.ModuleId);
            _confirmDelete = null;
            await LoadMeetings();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
